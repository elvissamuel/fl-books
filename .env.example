# Used to sign the admin session cookie. Generate with: openssl rand -base64 32
SESSION_SECRET=

# Admin API. Sign-in calls POST /api/v1/admin/public/login on this origin.
NEXT_PUBLIC_BASE_URL=
NEXT_PUBLIC_API_KEY=

# Google Identity Services client ID for the customer Sign In with Google button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
